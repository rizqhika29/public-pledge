# Network the app talks to: studionet (default) | localnet
# Testnet Bradbury needs the genlayer-js v2 SDK and is not supported by the pinned 1.1.8.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Address of your deployed PublicPledge contract (contracts/public_pledge.py).
# Leave it empty to use the Studionet contract the on-chain workflow deployed
# (see DEPLOYED_ON_STUDIONET in lib/config.ts). Required on localnet.
NEXT_PUBLIC_CONTRACT_ADDRESS=
